{
  "name": "dsh-task-guard",
  "version": "0.6.2",
  "type": "module",
  "main": "./index.js",
  "description": "Task-scoped tool narrowing for DSH: narrow the tool table once when a task starts (deny-only), restore it when the task ends. Ships a cross-process task lock and a taskId-tagged usage log. Zero dependencies.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/task-guard.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "context-caching",
    "task-scope",
    "deepseek-harness",
    "tools",
    "context-cache"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwq1223211/dsh-task-guard.git"
  },
  "homepage": "https://github.com/qwq1223211/dsh-task-guard#readme",
  "bugs": {
    "url": "https://github.com/qwq1223211/dsh-task-guard/issues"
  }
}
